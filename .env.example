# ── Reveal Cell Cam login ──────────────────────────────────────────────────────
REVEAL_EMAIL=you@example.com
REVEAL_PASSWORD=yourpassword

# ── Scraper (src/scraper.py) ───────────────────────────────────────────────────
S3_BUCKET_NAME=gorgewhitewater        # bucket where raw camera images are stored
CATEGORY=Husum                        # subfolder under tactacam/

# ── Gauge reader (src/gauge_reader.py) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6     # optional override; defaults to claude-sonnet-4-20250514
SOURCE_BUCKET=gorgewhitewater
SOURCE_PREFIX=tactacam/Husum/
OUTPUT_BUCKET=gorgegauge.com          # static-site S3 bucket
OUTPUT_KEY=gauge/husum/latestGauge.json
PUBLIC_IMAGE_BASE=https://gorgewhitewater.s3.us-east-2.amazonaws.com
